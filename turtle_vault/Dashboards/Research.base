filters:
  or:
    - file.inFolder("Research")
    - file.inFolder("Decisions")
properties:
  note.status:
    displayName: Status
  note.about:
    displayName: About
  note.opened:
    displayName: Opened
views:
  - type: table
    name: Open questions
    filters:
      and:
        - file.inFolder("Research")
        - note.status != "synthesized"
    order:
      - file.name
      - note.status
      - note.about
      - note.opened
    sort:
      - property: note.opened
        direction: ASC
  - type: table
    name: All research
    filters:
      and:
        - file.inFolder("Research")
    order:
      - file.name
      - note.status
      - note.about
      - note.opened
  - type: table
    name: Decisions
    filters:
      and:
        - file.inFolder("Decisions")
    order:
      - file.name
      - note.id
      - note.status
      - note.date
    sort:
      - property: note.id
        direction: ASC
