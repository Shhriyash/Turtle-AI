filters:
  and:
    - file.inFolder("Components")
properties:
  note.status:
    displayName: Status
  note.layer:
    displayName: Layer
  note.source:
    displayName: Source
  note.verified:
    displayName: Verified
views:
  - type: table
    name: Needs attention
    filters:
      or:
        - note.status == "flagged-off"
        - note.status == "partial"
        - note.status == "legacy"
        - note.status == "dead"
        - note.status == "unmounted"
    order:
      - file.name
      - note.status
      - note.layer
      - note.source
    sort:
      - property: note.status
        direction: ASC
  - type: table
    name: By layer
    order:
      - file.name
      - note.layer
      - note.status
      - note.source
    sort:
      - property: note.layer
        direction: ASC
      - property: file.name
        direction: ASC
  - type: table
    name: Voice
    filters:
      and:
        - note.layer == "voice"
    order:
      - file.name
      - note.status
      - note.source
  - type: table
    name: Memory
    filters:
      and:
        - note.layer == "memory"
    order:
      - file.name
      - note.status
      - note.source
  - type: table
    name: Staleness check
    order:
      - file.name
      - note.verified
      - note.layer
      - note.status
    sort:
      - property: note.verified
        direction: ASC
