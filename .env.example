# Copy to .env in the repo root and fill in your own values.
# The .env file is gitignored. Never commit a filled copy.

# Session signing (magic-link/session cookies) and admin dashboard gate.
# AUTH_SECRET_KEY has no default on purpose — generate a real random secret,
# e.g.: python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_SECRET_KEY=""
TURTLE_ADMIN_TOKEN=""

# Externally reachable base URL of this deployment (no trailing slash). Used
# to build magic links, forget-me links, and the Google Calendar OAuth
# redirect_uri. Must be the real public HTTPS URL in production.
TURTLE_PUBLIC_BASE_URL="http://127.0.0.1:8765"

# Discord channel. From the Discord Developer Portal (discord.com/developers):
#  General Information -> "Application ID"  -> DISCORD_APPLICATION_ID
#  General Information -> "Public Key"      -> DISCORD_PUBLIC_KEY
#  Bot tab -> "Reset Token" / copy          -> DISCORD_BOT_TOKEN
DISCORD_APPLICATION_ID=""
DISCORD_PUBLIC_KEY=""
DISCORD_BOT_TOKEN=""

# Core LLM (OpenRouter). Keys rotate 1 -> 2 -> 3 on rate limit.
# A single OPENROUTER_API_KEY also works if you do not need rotation.
OPEN_ROUTER_MODEL="nvidia/nemotron-3-nano-30b-a3b:free"
OPEN_ROUTER_API_KEY_1="your_openrouter_api_key_1"
OPEN_ROUTER_API_KEY_2="your_openrouter_api_key_2"
OPEN_ROUTER_API_KEY_3="your_openrouter_api_key_3"
OPENROUTER_API_KEY=""
OPENROUTER_MODEL=""
OPENROUTER_TOOL_FALLBACK_MODEL=""
OPENROUTER_APP_URL="your_app_url"
OPENROUTER_APP_TITLE="your_app_title"

# Fallback LLM and STT (Groq Whisper). Leave empty to disable Groq.
GROQ_PRIMARY_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant
GROQ_API_KEY="your_groq_api_key"
GROQ_API_KEY2="your_groq_api_key_2"
STT_MODEL=""

# Azure OpenAI (optional alternative provider)
AZURE_OPENAI_ENDPOINT=""
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_API_VERSION=""
AZURE_OPENAI_MODEL=""

# RAG conversation memory
COHERE_API_KEY=your_cohere_api_key
RAG_FAISS_INDEX_TYPE=""
RAG_FAISS_HNSW_M=""
RAG_FAISS_HNSW_EF_SEARCH=""

# TTS. Deepgram primary, Groq Orpheus fallback.
DEEPGRAM_API_KEY=your_deepgram_api_key
DEEPGRAM_TTS_MODEL=aura-2-orion-en
DEEPGRAM_TTS_ENCODING=linear16
DEEPGRAM_TTS_CONTAINER=wav
DEEPGRAM_TTS_SAMPLE_RATE=24000
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=orion
GROQ_TTS_FORMAT=wav

# Email. Use a Gmail app password, not your account password.
TURTLE_EMAIL_NAME="Your Name"
TURTLE_EMAIL_ADDRESS="your_email@gmail.com"
TURTLE_EMAIL_PASSKEY="your_app_password"

# Personal memory
TURTLE_PERSONAL_MEMORY_ENABLED=1
TURTLE_PERSONAL_MEMORY_DREAM_PASS_ENABLED=0
TURTLE_PERSONAL_MEMORY_STAGE_B_ENABLED=1

# Google Maps Platform — Places API (New) + Routes API.
# Enable both APIs in your Google Cloud project and restrict the key.
GOOGLE_MAPS_API_KEY=""

# Google Calendar. GOOGLE_CALENDAR_CREDENTIALS_JSON is the OAuth client JSON
# downloaded from Google Cloud Console (APIs & Services > Credentials >
# OAuth client ID, type "Web application", with a redirect URI of
# {TURTLE_PUBLIC_BASE_URL}/integrations/google_calendar/callback). Once this
# is set, each signed-in web user connects their OWN calendar by visiting
# /integrations/google_calendar/connect — no per-user env var needed.
# GOOGLE_CALENDAR_TOKEN_JSON is a legacy fallback: a single global OAuth
# token (e.g. from the OAuth 2.0 Playground) for single-tenant deployments
# that never use the in-app connect flow.
GOOGLE_CALENDAR_CREDENTIALS_JSON=""
GOOGLE_CALENDAR_TOKEN_JSON=""

# Optional monitoring
LOGFIRE_TOKEN=your_logfire_token

# --- Cloud deployment (TURTLE_DEPLOY=cloud) --------------------------------
# Deployment mode: "local" (default) or "cloud". Selects Postgres/Redis-backed
# storage over SQLite/disk/in-memory throughout core/storage/ — see
# core/storage/factory.py. Leave unset for local dev.
TURTLE_DEPLOY=local

# Neon Postgres connection string (Vercel Marketplace: `vercel integration
# add neon`). Use the POOLED endpoint (...-pooler.../...) so short-lived
# serverless invocations don't exhaust direct connections.
DATABASE_URL=""

# Upstash Redis (Vercel Marketplace: `vercel integration add upstash`).
# REDIS_URL wins if both are set; UPSTASH_REDIS_URL is Upstash's own alias.
REDIS_URL=""
UPSTASH_REDIS_URL=""

# RETIRED (WP 1.B / S-7.3): used to be the ONE secret for both GitHub
# Actions' cron-tick call and Turtle's own self-invoked job calls — split
# below into CRON_TICK_SECRET and INTERNAL_JOB_SECRET so a leaked value only
# buys one surface. Leave unset; nothing reads it any more.
CRON_SHARED_SECRET=""

# The ONLY secret GitHub Actions holds. Presented as a bearer token to
# POST /internal/cron-tick (apps/cron_tick_routes.py, the cloud replacement
# for the local RoutineScheduler) — add it (plus the endpoint's public URL)
# as GitHub Actions repo secrets CRON_TICK_SECRET / CRON_TICK_URL for
# .github/workflows/cron-tick.yml. Do NOT reuse this value for
# INTERNAL_JOB_SECRET below — GitHub Actions should never be able to
# authenticate as Turtle's own internal job calls.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
CRON_TICK_SECRET=""

# NEVER leaves Vercel. Authenticates Turtle's own self-invoked internal job
# calls — a bearer token PLUS the HMAC key for a signed-request envelope
# (core/internal_auth.py) covering each request's timestamp, nonce and body:
#  1. apps/channels/discord.py's cloud-mode deferred-interaction handling:
#     Discord's 3-second ACK deadline forces a defer, and rather than betting
#     on an unconfirmed Python background-task guarantee post-response on
#     Vercel, cloud mode self-invokes POST /channels/discord/process as an
#     independent request.
#  2. core/worker.py's embed-personal-memory self-invoke: POSTs
#     /internal/embed-personal-memory as an independent request rather than
#     risking a detached background task on the same platform.
# Both self-calls send only an opaque job id — the real payload (with any
# identity field) is stashed server-side in Redis first, so a forged wire
# body can't impersonate a user even with this secret leaked.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_JOB_SECRET=""

# Secret token verified on the Telegram webhook (apps/channels — cloud mode
# replaces the local long-polling gateway with a webhook, since a serverless
# invocation cannot hold a persistent poll connection open). Set the SAME
# value via Telegram's setWebhook secret_token parameter.
TELEGRAM_WEBHOOK_SECRET=""
